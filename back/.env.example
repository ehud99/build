# Copiar a `back/.env` y ajustar.

# PostgreSQL de docker-compose.yml (puerto 5434 en la PC).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/build_dev

# Firma de la cookie de sesión: en producción, una clave larga y secreta.
SECRET_KEY=dev-secret-change-me
# `true` detrás de HTTPS.
COOKIE_SECURE=false

# Clave que pide el registro. Vacía = registro cerrado.
INVITE_CODE=amigos-2026

# «Hoy» de los objetivos.
APP_TIMEZONE=America/Lima
